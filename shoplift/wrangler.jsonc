{
  "name": "shoplift",
  "main": "src/worker.js",
  "compatibility_date": "2026-06-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/agents.js"],
    "not_found_handling": "404-page"
  },
  "triggers": { "crons": ["17 * * * *"] },
  "observability": { "enabled": true }
}
