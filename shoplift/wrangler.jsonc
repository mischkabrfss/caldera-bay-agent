{
  "name": "shoplift",
  "main": "src/worker.js",
  "compatibility_date": "2026-06-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/agents.js", "/", "/index.html", "/robots.txt", "/sitemap.xml"],
    "not_found_handling": "404-page"
  },
  "triggers": { "crons": ["*/7 * * * *"] },
  "kv_namespaces": [{ "binding": "DATA" }],
  // Anti-abus intégré à Cloudflare (gratuit) : 20 analyses par minute et par IP sur les routes coûteuses.
  // Connexion et récupération d'accès : 3 essais par minute et par e-mail (protège aussi sur une adresse *.workers.dev).
  "ratelimits": [
    { "name": "LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
    { "name": "AUTH_LIMITER", "namespace_id": "1002", "simple": { "limit": 3, "period": 60 } }
  ],
  "observability": { "enabled": true }
}
