{
  "name": "shoplift",
  "main": "src/worker.js",
  "compatibility_date": "2026-06-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/agents.js"],
    "not_found_handling": "404-page"
  },
  "triggers": { "crons": ["17 * * * *"] },
  // Anti-abus intégré à Cloudflare (gratuit) : 20 analyses par minute et par IP sur les routes coûteuses.
  "ratelimits": [{ "name": "LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }],
  "observability": { "enabled": true }
}
